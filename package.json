{
  "name": "@xidong-ai/dsh-rate-limiter",
  "version": "0.1.0",
  "description": "DeepSeek Harness 主动限速插件：按 provider 令牌桶限速，超限延迟排队而非失败",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xidong-AI/dsh-rate-limiter.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild lib/index.ts lib/limiter.ts lib/config.ts --format=esm --platform=node --target=node22 --outdir=lib",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "0.1.0-rc.6",
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "typescript": "^5",
    "vitest": "^3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
